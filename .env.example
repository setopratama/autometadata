# ==============================================================================
# IMGMETA-SEO Configuration (OpenRouter Setup)
# ==============================================================================

# Server Configuration
PORT=3030
NODE_ENV=development

# Working Directories & Storage
PHOTO_DIR=photo
DB_PATH=imgmeta.db

# ------------------------------------------------------------------------------
# OPENROUTER CONFIGURATION (Unified Vision + SEO Pipeline)
# ------------------------------------------------------------------------------
# Dapatkan API Key dari: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── TAHAP 1: AI VISION (Visual Analysis) ──
# Rekomendasi Model Vision Murah & Cepat:
# 1. google/gemini-2.0-flash-001    (~ $0.10 / 1M token - Sangat cepat & akurat) [RECOMMENDED]
# 2. openai/gpt-4o-mini             (~ $0.15 / 1M token - Standar industri)
# 3. qwen/qwen-2.5-vl-72b-instruct  (~ $0.20 / 1M token - Vision open-source terbaik)
VISION_MODEL=google/gemini-2.0-flash-001

# ── TAHAP 2: SEO STOCK REFINEMENT (Title, Description, 15-25 Keywords) ──
# Rekomendasi Model Teks SEO Murah & Cerdas:
# 1. deepseek/deepseek-chat         (~ $0.14 / 1M token - DeepSeek V3 matang microstock) [RECOMMENDED]
# 2. meta-llama/llama-3.3-70b-instruct (~ $0.12 / 1M token - Sangat pintar SEO)
# 3. google/gemini-2.0-flash-001    (~ $0.10 / 1M token - Super hemat jika ingin 1 model untuk semua)
SEO_MODEL=deepseek/deepseek-chat

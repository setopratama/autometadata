# Dependencies (Zero Runtime Dependencies)
node_modules/
package-lock.json

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env
!.env.example

# SQLite Database, Journal & WAL Files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
imgmeta.db
imgmeta.db-wal
imgmeta.db-shm

# Runtime Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
imgmeta.log

# Temporary / Backup Files
*.bak
*.tmp
*.temp

# OS & Editor Generated Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.lnk
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Ignore working photo directory contents & temp thumbnails, keep structure
photo/*
photo/**
photo/.tmp/
!photo/.gitkeep
!photo/.gitignore
